  (text "RX inputs, monitor buffers, headphone mixers/amps (positions A and B)." (exclude_from_sim no) (at 20.32 20.32 0) (effects (font (size 1.778 1.778) (bold yes)) (justify left bottom)) (uuid "9b24ee24-12f5-5621-8d03-3028cecd928b"))
  (text "RX in: 10k bridging load, rear 10k trim to GND (hot phones-jack sources are simply trimmed down), AC-coupled into a +15 dB buffer -> RX_L_BUS / RX_R_BUS at -15 dBV." (exclude_from_sim no) (at 20.32 24.13 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "c38a885b-e092-563f-b188-3c3b26cf5827"))
  (text "Mono rig cables tie RX L and RX R at the DE-9 (Keying+Rear sheet, with the filter/clamp)." (exclude_from_sim no) (at 20.32 26.67 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "f42617f4-cf5d-5616-a183-cb8ce9227251"))
  (text "Monitor: TX_MON (pre-intercom) -> front MON pot per position -> unity buffer -> MON_A / MON_B (off .. -15 dBV)." (exclude_from_sim no) (at 20.32 29.21 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "70b07976-79f7-5107-9356-546af19be9b4"))
  (text "Each ear: RX side + MON summed passively (10k+10k into the 10k volume gang, -9.5 dB) -> NJM4556A +24 dB -> 10R -> 470u -> bead + 10n -> jacks; sleeves to CHASSIS." (exclude_from_sim no) (at 20.32 31.75 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "dfd3b7e8-01da-54af-87c7-801e1d117282"))
  (text "Max ~-0.4 dBV open (17 mW/32R, 22 mW/16R through the 10R build-out; one headset per position). 3.5 mm, 1/4\" and the TRRS phones side (J203/J303 on the preamp sheets, via PH_x_L/R) are paralleled." (exclude_from_sim no) (at 20.32 34.29 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "778b5d97-062a-5ee7-b326-fc4eeedc7e9c"))
  (text "+15 dB (1 + 47k/10k), unity at DC (C618/C619); trims to GND, +in biased to VREF via 100k (VREF noise gain ~1); R635/C622 RF stop at the pin" (exclude_from_sim no) (at 20.32 187.96 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "bc0c08fc-0712-5d6d-9d73-d546f40e7e93"))
  (text "MON pots: front panel, per position" (exclude_from_sim no) (at 121.92 44.45 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "323b6e89-68ea-5b27-b6c7-636c95261078"))
  (text "NJM4556A: 70 mA output, drives 16R phones from 9 V" (exclude_from_sim no) (at 177.8 99.06 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "57f97efb-41ab-51db-b3b7-fd5509380bff"))
  (text "C620/C621: +9V bulk next to U603/U604 (class-B return current)" (exclude_from_sim no) (at 177.8 101.6 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "7398b2cb-7b4e-5cd1-bc83-df09c9d1ff8d"))
  (text "POSITION A" (exclude_from_sim no) (at 20.32 110.49 0) (effects (font (size 1.778 1.778) (bold yes)) (justify left bottom)) (uuid "1032f7e8-9f1a-588b-a0b8-5a3d92988909"))
  (text "POSITION B" (exclude_from_sim no) (at 162.56 110.49 0) (effects (font (size 1.778 1.778) (bold yes)) (justify left bottom)) (uuid "b9a073a6-2ca0-57a8-b6bf-707344828710"))
  (text "RV604/RV606: dual-gang volume; all pots return to VREF (no DC on wipers)." (exclude_from_sim no) (at 20.32 171.45 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "69f9d553-7b61-51ce-98c6-4344a7c13cd6"))
  (text "Global nets: RX_L_IN/RX_R_IN from Keying+Rear; TX_MON from TX Bus; RX_x_BUS to TX Bus line-out select; PH_x_L/R to the preamp TRRS jacks." (exclude_from_sim no) (at 20.32 173.99 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "08594745-0466-5c9d-8c58-1fe929fb1c75"))
