	(text "Mute -- TS12A12511 SPDT analog switch. One file, three instances (Preamp A, Preamp B, Intercom)."
		(exclude_from_sim no)
		(at 20.32 20.32 0)
		(effects
			(font
				(size 1.778 1.778)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "0af3f2d0-f99d-5f41-b4f2-6d7c67aca659")
	)
	(text "Control input: VIH guaranteed 2.4 V (10 V supply) / 5 V (12 V supply), ~1.5 V typ; every MUTE source in this design sits >= 6 V loaded. IIN 0.1 uA max: the 1M pulldown holds MUTE low with no source active and keeps the power-on hold light."
		(exclude_from_sim no)
		(at 20.32 29.21 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "12ffb73c-8d3b-5d82-a717-99a7a8af378e")
	)
	(text "MUTE=1 (0/+9V logic) selects NO: OUT is clamped to VREF and IN is isolated (off isolation -70 dB at 1 MHz, far better at audio). MUTE=0 passes IN via NC (Ron ~5 ohm, break-before-make ~30 ns)."
		(exclude_from_sim no)
		(at 20.32 24.13 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "23426e71-579b-50a4-84cf-5a9ba2cc1fea")
	)
	(text "V- to GND (single supply); thermal pad to GND or floating."
		(exclude_from_sim no)
		(at 96.52 78.74 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "585cddab-f343-51bc-95ad-de380bb962a2")
	)
	(text "NC = signal, NO = VREF, COM = OUT"
		(exclude_from_sim no)
		(at 60.96 60.96 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "dcf8f7c9-8915-520c-9689-73a21ef805e8")
	)
	(text "No DC across the switch: IN comes from a VREF-referenced stage with unity DC gain and the OUT load returns to VREF, so the switching step is only the op-amp Vos (a few mV, -48 dBV) -- no pop."
		(exclude_from_sim no)
		(at 20.32 26.67 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "f8b52e84-3888-5dd9-9984-f1ab0c53bcc7")
	)
