  (text "TX bus -- summing amp, monitor tap, intercom mute, mic out to rig, isolated stereo line out." (exclude_from_sim no) (at 20.32 20.32 0) (effects (font (size 1.778 1.778) (bold yes)) (justify left bottom)) (uuid "ec388318-0a5b-5eeb-b876-fd7b8cf53f05"))
  (text "Bus order: sum -> TX_MON (monitor pots, RX+Phones sheet) -> intercom mute -> TX_MIX -> mic out pad / line out TX tap." (exclude_from_sim no) (at 20.32 24.13 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "8d000219-ee50-5ebb-ab31-2af6056e5d05"))
  (text "Levels (LEVELS.md): level-pot wipers -21 dBV -> sum +6 dB -> -15 dBV. Mic out: +5 dB driver, rear trim -20..0 dB, MIC pad -26 dB (~590R source) or LINE direct." (exclude_from_sim no) (at 20.32 26.67 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "45400f22-c05d-520e-ad82-6a8ef3079d26"))
  (text "Intercom: momentary, mutes TX downstream of the monitor tap; locked out while PTT_ACTIVE=1 (Keying sheet). Control lines are DC logic 0/+9V, active high." (exclude_from_sim no) (at 20.32 29.21 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "3eb0452b-de1c-55cb-9460-3a022a874165"))
  (text "Line out: per-side source jumper (RX L / RX R / blend / TX mix), +5 dB, rear trim -20..0 dB, 600R:600R 1:1 transformer, C-L-C at the jack." (exclude_from_sim no) (at 20.32 31.75 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "bd7f381e-28ed-5ccd-9443-c44ac9f66d45"))
  (text "+6 dB inverting sum (Rf/Rin = 2)" (exclude_from_sim no) (at 20.32 81.28 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "40612b0e-7a62-59f4-a621-ab818b13c08d"))
  (text "R404 isolates the cap load" (exclude_from_sim no) (at 20.32 83.82 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "093e7d6f-2418-581c-8a18-2bda06a3f039"))
  (text "post-mute TX mix (line level; crosses to rear board)" (exclude_from_sim no) (at 116.84 40.64 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "181cb900-99e4-5d6b-a504-86d78862bab3"))
  (text "IC_MUTE = NOT(button up OR PTT_ACTIVE): pressed & not keyed -> mute" (exclude_from_sim no) (at 25.4 124.46 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "fa159596-f0f4-56c2-a84b-bca7a8f03d00"))
  (text "LED from the raw rail (droppers), never from +9V" (exclude_from_sim no) (at 25.4 127 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "b289192d-c0bf-5d7e-a451-abfb378c78ba"))
  (text "mic out driver U403A +5 dB (rear board); RV401 rear trim; C418/R435 RF stop at the input pin" (exclude_from_sim no) (at 165.1 43.18 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "b9316f58-960b-5658-97b3-cd320fa98824"))
  (text "JP401: A-C = MIC (12k/620R pad, -26 dB, ~590R source)" (exclude_from_sim no) (at 205.74 88.9 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "e1bc304c-20da-5e19-a4a3-92ff001688e9"))
  (text "        B-C = LINE (-10 dBV, drives 600R via R422)" (exclude_from_sim no) (at 205.74 91.44 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "23ebdbc7-ecf4-5766-9319-ed849be292b6"))
  (text "C412/C414 1n: RF corner ~270 kHz against 600R. C422/C423: block sound-card plug-in power." (exclude_from_sim no) (at 205.74 99.06 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "d1aacbf9-4f84-5c98-b9aa-4352bba515d4"))
  (text "C417 blocks the driver DC; the pad returns to GND (VREF noise is padded too)" (exclude_from_sim no) (at 205.74 93.98 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "c423a994-b7b5-502b-9f4f-0d22c975e887"))
  (text "C408 non-polar: rigs may bias the mic pin. DE-9 filter/clamp on Keying+Rear." (exclude_from_sim no) (at 205.74 96.52 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "2ef09df8-dc67-56af-ae48-f43a37a47ba2"))
  (text "blend = (L+R)/2 via 22k+22k (-6.8 dB into the trim; L/R crosstalk -53 dB)" (exclude_from_sim no) (at 137.16 78.74 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "60b456c3-f895-5b55-af1e-c23486223498"))
  (text "J403/J404: shunt 1-2 RX L, 3-4 RX R, 5-6 blend, 7-8 TX mix. T401/T402 600R:600R 1:1 (e.g. Bourns LM-NP-1001-B1L; verify 150 Hz" (exclude_from_sim no) (at 20.32 174 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "0a698e44-5357-5a88-9466-524b5500e805"))
  (text "at -10 dBV without saturation -- TODO). LOUT_RET is the isolated sleeve, not GND: J401 must be an insulated-bushing jack." (exclude_from_sim no) (at 20.32 176.53 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "2346b759-5afc-5ffa-ab5e-9b3a97605235"))
