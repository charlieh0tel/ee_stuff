	(text "Max ~-0.4 dBV open (17 mW/32R, 22 mW/16R through the 10R build-out; one headset per position). 3.5 mm, 1/4\" and the TRRS phones side (J1103/J1303 on the preamp sheets, via PH_x_L/R) are paralleled."
		(exclude_from_sim no)
		(at 20.32 34.29 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "778b5d97-062a-5ee7-b326-fc4eeedc7e9c")
	)
	(text "RX in (rear board) -- 10k bridging load, rear trims, +15 dB buffers -> RX_L_BUS / RX_R_BUS."
		(exclude_from_sim no)
		(at 20.32 20.32 0)
		(effects
			(font
				(size 1.778 1.778)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "9b24ee24-12f5-5621-8d03-3028cecd928b")
	)
	(text "+15 dB (1 + 47k/10k), unity at DC (C3403/C3404); trims to GND, +in biased to VREF via 100k (VREF noise gain ~1); R3403/C3405 RF stop at the pin"
		(exclude_from_sim no)
		(at 20.32 187.96 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "bc0c08fc-0712-5d6d-9d73-d546f40e7e93")
	)
	(text "RX in: the rear 10k trim to GND is the bridging load (hot phones-jack sources are simply trimmed down), AC-coupled into a +15 dB buffer -> RX_L_BUS / RX_R_BUS at -15 dBV."
		(exclude_from_sim no)
		(at 20.32 24.13 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "c38a885b-e092-563f-b188-3c3b26cf5827")
	)
	(text "Mono rig cables tie RX L and RX R at the DE-9 (Rear I/O sheet, with the filter/clamp)."
		(exclude_from_sim no)
		(at 20.32 26.67 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "f42617f4-cf5d-5616-a183-cb8ce9227251")
	)
