  (text "FRONT BOARD (vertical, behind the front panel): mic jacks + preamps + mutes, phones jacks. Mic level never leaves this board." (exclude_from_sim no) (at 20.32 20.32 0) (effects (font (size 1.778 1.778) (bold yes)) (justify left bottom)) (uuid "71a06e5e-70a3-5958-b058-c94f1a18acce"))
  (text "Phones jack sleeves and the TRRS common return to board GND (floating headset load), not CHASSIS -- keeps headphone current out of the mic reference path." (exclude_from_sim no) (at 20.32 24.13 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "43e43c7b-20be-5a88-8330-c667ccd2c627"))
